# Cyvera Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=cyvera-super-secret-security-scanner-jwt-key-change-in-production-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL default, or sqlite:///./cyvera.db for local dev)
DATABASE_URL=sqlite:///./cyvera.db
POSTGRES_USER=cyvera
POSTGRES_PASSWORD=cyvera_secret_pw
POSTGRES_DB=cyvera_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# OWASP ZAP Service
ZAP_BASE_URL=http://localhost:8080
ZAP_API_KEY=cyvera-zap-internal-api-key
ZAP_MOCK_FALLBACK=True

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# SSRF Security Guard
ALLOW_LOCAL_TARGETS=True  # Allow scanning docker/vulnerable-app during dev
